<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ets2_roads</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- GPL v2: https://github.com/sk-zk/TruckLib - reads ETS2 map format 907 (game 1.59-1.61) -->
    <PackageReference Include="TruckLib" Version="0.5.1" />
  </ItemGroup>

</Project>
